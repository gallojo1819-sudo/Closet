{
  "file": "color.json",
  "chip_id": "color",
  "label": "Color",
  "type": "filter",
  "rule_prefix": "COL",
  "what_it_is": "Not a house. A dropdown filter chip in src/routes/lookbook.tsx listing every distinct colour string in Joe's live garments as swatches. It stacks with any house chip.",
  "current_behavior": {
    "code": "lookHasColor(pieces, color): true if ANY piece's colors[] contains exactly the chosen string. Applied inside buildReshuffleRow legal().",
    "problems": [
      "Accent-only matches: a look passes 'pink' because of the Golden Goose pink star sneakers g_rxglifsoqobm, or 'light blue' because of the Gucci sneakers g_kde45hmnqie9.",
      "Raw strings aren't canonical: 'navy blue/brown. match original', 'navy/black', 'maroon/brown', 'light grey' vs 'grey', 'multicolor' are separate swatches.",
      "No palette check against the house: RRL + pink simply returns looks with pink sneakers/polos.",
      "Secondary colours count ('cream' is a secondary on many plates), so 'cream' matches almost everything."
    ]
  },
  "proposed_rules": [
    {
      "id": "COL-1",
      "rule": "Canonicalise before matching.",
      "map": {
        "navy blue/brown. match original": [
          "navy",
          "brown"
        ],
        "navy/black": [
          "navy",
          "black"
        ],
        "maroon/brown": [
          "maroon",
          "brown"
        ],
        "light grey": [
          "grey"
        ],
        "charcoal": [
          "grey"
        ],
        "multicolor": [],
        "silver": []
      },
      "families": {
        "blue": [
          "navy",
          "blue",
          "light blue"
        ],
        "brown": [
          "brown",
          "chocolate",
          "tan",
          "taupe",
          "khaki",
          "rust"
        ],
        "cream": [
          "cream",
          "ivory",
          "beige",
          "white",
          "ecru"
        ],
        "grey": [
          "grey",
          "light grey",
          "charcoal",
          "silver"
        ],
        "green": [
          "green",
          "olive",
          "sage",
          "mint"
        ],
        "red": [
          "burgundy",
          "maroon",
          "red"
        ],
        "pink": [
          "pink",
          "mauve"
        ],
        "black": [
          "black"
        ],
        "yellow": [
          "yellow"
        ]
      }
    },
    {
      "id": "COL-2",
      "rule": "Lead role: the chosen colour must be colors[0] (dominant) of the top, outer or bottom. A shoe/accessory or a secondary colour alone is not enough.",
      "severity": "hard",
      "fallback": "If fewer than 3 lead matches, fill with secondary-colour matches at −15."
    },
    {
      "id": "COL-3",
      "rule": "Accent budget: if the chosen colour is an accent (pink, mauve, yellow, mint, burgundy, red, rust, green), every other piece must be neutral (navy, grey, cream/ivory/beige/white, brown, black, denim blue).",
      "severity": "hard"
    },
    {
      "id": "COL-4",
      "rule": "House intersection: if the chosen family is not in house.palette base ∪ accent, return 0 looks + empty-state copy, never an off-palette look.",
      "severity": "hard",
      "empty_state_copy": "No {House} look in {color}: {House} lives in {palette}. Try {closest family}."
    },
    {
      "id": "COL-5",
      "rule": "Tonal looks: if ≥2 core pieces share the chosen family, require ≥2 different textures (knit, suede, cord, denim, linen, wool).",
      "severity": "soft",
      "delta": -10
    },
    {
      "id": "COL-6",
      "rule": "Never let footwear be the only carrier of the colour.",
      "severity": "hard"
    }
  ],
